Q38. CUSTOMER SEGMENTATION USING CLUSTERING
-------------------------------------------
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

data = pd.DataFrame({"income":[20,25,30,80,90,100],
                     "spending":[15,20,25,75,85,95],
                     "visits":[2,3,4,8,9,10]})
X = StandardScaler().fit_transform(data)
model = KMeans(n_clusters=2, random_state=1, n_init=10)
data["segment"] = model.fit_predict(X)
print(data)

Q39. K-MEANS CUSTOMER SPENDING PATTERNS
---------------------------------------
import pandas as pd
from sklearn.cluster import KMeans

data = pd.DataFrame({"customer_id":[1,2,3,4,5,6],
                     "amount":[100,150,1200,1300,200,1500],
                     "visits":[2,3,10,12,4,15]})
X = data[["amount","visits"]]
model = KMeans(n_clusters=2, random_state=1, n_init=10)
data["cluster"] = model.fit_predict(X)
print(data)

Q40. K-MEANS CLUSTERS WITH VISUALIZATION
----------------------------------------
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

data = pd.DataFrame({"customer_id":[1,2,3,4,5,6,7,8],
                     "spending":[100,120,150,1000,1100,1200,300,350],
                     "items":[2,3,4,20,22,25,6,7]})
X = data[["spending","items"]]
model = KMeans(n_clusters=3, random_state=1, n_init=10)
data["cluster"] = model.fit_predict(X)
print(data)
plt.scatter(data["spending"], data["items"], c=data["cluster"])
plt.xlabel("Spending"); plt.ylabel("Items Purchased")
plt.title("Customer Segments")
plt.show()
