Q15. CITY TEMPERATURE ANALYSIS
------------------------------
import pandas as pd

data = pd.DataFrame({
    "City":["A","A","B","B","C","C"],
    "Temperature":[25,30,20,35,28,29]
})
print("Mean:\n", data.groupby("City")["Temperature"].mean())
print("Standard deviation:\n", data.groupby("City")["Temperature"].std())
ranges = data.groupby("City")["Temperature"].agg(lambda x: x.max()-x.min())
print("Highest range:", ranges.idxmax())
print("Most consistent:", data.groupby("City")["Temperature"].std().idxmin())

