Q1. SUBJECT-WISE AVERAGE AND HIGHEST AVERAGE
--------------------------------------------
import numpy as np

student_scores = np.array([
    [85, 78, 90, 80],
    [75, 88, 82, 79],
    [92, 90, 86, 91],
    [80, 84, 89, 85]
])
subjects = ["Math", "Science", "English", "History"]
avg = student_scores.mean(axis=0)
print(dict(zip(subjects, avg)))
print("Highest average:", subjects[np.argmax(avg)])

