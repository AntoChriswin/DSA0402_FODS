Q28. CART CAR PRICE PREDICTION
------------------------------
import pandas as pd
from sklearn.tree import DecisionTreeRegressor, export_text

data = pd.DataFrame({
    "mileage":[20000,40000,60000,80000,100000],
    "age":[2,3,5,6,8],
    "price":[900000,750000,600000,450000,300000]
})
X = data[["mileage","age"]]; y = data["price"]
model = DecisionTreeRegressor(max_depth=3, random_state=1).fit(X,y)
mileage = float(input("Mileage: "))
age = float(input("Age: "))
print("Predicted price:", model.predict([[mileage,age]])[0])
print(export_text(model, feature_names=list(X.columns)))

Q29. DECISION TREE IRIS CLASSIFICATION
--------------------------------------
from sklearn.datasets import load_iris
from sklearn.tree import DecisionTreeClassifier

iris = load_iris()
model = DecisionTreeClassifier(random_state=1).fit(iris.data, iris.target)
x = [float(input("Sepal length: ")), float(input("Sepal width: ")),
     float(input("Petal length: ")), float(input("Petal width: "))]
print("Predicted species:", iris.target_names[model.predict([x])[0]])

