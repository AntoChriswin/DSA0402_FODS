Q31. KNN TREATMENT OUTCOME WITH METRICS
---------------------------------------
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
import pandas as pd

data = pd.DataFrame({
    "age":[20,25,30,35,40,45,50,55,60,65],
    "bp":[110,120,125,130,135,140,145,150,155,160],
    "outcome":["Good","Good","Good","Bad","Good","Bad","Bad","Bad","Bad","Bad"]
})
X = data[["age","bp"]]; y = data["outcome"]
Xtr,Xte,ytr,yte = train_test_split(X,y,test_size=.3,random_state=1)
model = KNeighborsClassifier(n_neighbors=3).fit(Xtr,ytr)
p = model.predict(Xte)
print("Accuracy:", accuracy_score(yte,p))
print("Precision:", precision_score(yte,p,pos_label="Good"))
print("Recall:", recall_score(yte,p,pos_label="Good"))
print("F1:", f1_score(yte,p,pos_label="Good"))
print(pd.DataFrame({"Actual":yte,"Predicted":p}))

