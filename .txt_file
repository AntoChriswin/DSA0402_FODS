Q20. CUSTOMER FEEDBACK WORD ANALYSIS
------------------------------------
import pandas as pd
import re
import matplotlib.pyplot as plt
from collections import Counter

data = pd.read_csv("data.csv")
stop = {"the","and","is","a","an","of","to","in","for","on"}
text = " ".join(data["feedback"]).lower()
words = [w for w in re.findall(r"\b\w+\b", text) if w not in stop]
n = int(input("Enter N: "))
top = Counter(words).most_common(n)
print(top)
plt.bar([x[0] for x in top], [x[1] for x in top])
plt.xticks(rotation=45); plt.show()

Q21. AGE AND BODY FAT STATISTICS WITH PLOTS
-------------------------------------------
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import probplot

data = pd.DataFrame({"age":[20,22,25,28,30,35], "fat":[15,18,20,22,25,28]})
print(data.mean(), data.median(), data.std())
data.boxplot(); plt.show()
plt.scatter(data["age"], data["fat"]); plt.show()
probplot(data["age"], dist="norm", plot=plt); plt.show()

Q22. 95% CONFIDENCE INTERVAL FOR TWO GROUPS
-------------------------------------------
import numpy as np
from scipy.stats import t

drug = np.array([8,10,9,12,11,10,13,9])
placebo = np.array([3,5,4,6,5,4,7,3])

def ci(x):
    m = x.mean()
    e = t.ppf(.975, len(x)-1) * x.std(ddof=1)/np.sqrt(len(x))
    return m-e, m+e

print("Drug CI:", ci(drug))
print("Placebo CI:", ci(placebo))

Q23. A/B TEST FOR CONVERSION RATES
----------------------------------
from scipy.stats import ttest_ind

A = [0.12,0.15,0.11,0.14,0.13]
B = [0.18,0.17,0.16,0.19,0.15]
stat, p = ttest_ind(A, B)
print("p-value:", p)
print("Significant" if p < .05 else "Not significant")

Q24. POINT ESTIMATION AND CONFIDENCE INTERVAL
---------------------------------------------
import pandas as pd
import numpy as np
from scipy.stats import t

data = pd.read_csv("rare_elements.csv").iloc[:,0].dropna().to_numpy()
n = int(input("Sample size: "))
level = float(input("Confidence level (e.g. 0.95): "))
precision = float(input("Precision: "))
sample = data[:n]
mean = sample.mean()
margin = t.ppf((1+level)/2, n-1)*sample.std(ddof=1)/np.sqrt(n)
print("Point estimate:", mean)
print("Confidence interval:", mean-margin, mean+margin)
print("Required precision:", precision)

Q25. CONFIDENCE INTERVAL FOR CUSTOMER RATINGS
---------------------------------------------
import pandas as pd
from scipy.stats import t
import numpy as np

data = pd.read_csv("customer_reviews.csv")
x = data["rating"].dropna()
mean = x.mean()
margin = t.ppf(.975, len(x)-1)*x.std(ddof=1)/np.sqrt(len(x))
print("Mean rating:", mean)
print("95% CI:", mean-margin, mean+margin)

Q26. HYPOTHESIS TESTING FOR TREATMENT
-------------------------------------
import numpy as np
from scipy.stats import ttest_ind
import matplotlib.pyplot as plt

control = np.array([70,72,68,75,71,73])
treatment = np.array([60,62,58,65,61,59])
stat, p = ttest_ind(control, treatment)
print("t-statistic:", stat, "p-value:", p)
plt.boxplot([control, treatment], labels=["Control","Treatment"])
plt.show()

